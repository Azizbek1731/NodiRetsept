# ── NodiRetsept konfiguratsiyasi ───────────────────────────────
PORT=4000
NODE_ENV=development

# Saytning tashqi manzili — QR kodlar shu manzilga yo'naltiriladi.
# Serverga joylashtirganda o'z domeningizga o'zgartiring, masalan:
# PUBLIC_URL=https://retsept.example.uz
PUBLIC_URL=http://localhost:4000

# Sessiya kalitini ishga tushirishdan oldin albatta o'zgartiring!
SESSION_SECRET=tasodifiy_uzun_maxfiy_kalit

# Telegram bot
TELEGRAM_BOT_TOKEN=bu_yerga_bot_tokeningizni_qoying
TELEGRAM_ENABLED=true

# Birinchi ishga tushishda yaratiladigan admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuchli_parol_qoying
ADMIN_NAME=Tizim Administratori
