<%- include('../partials/app-head', { pageTitle: t('nav.blank'), pageSub: t('admin.globalBlankSub') }) %>

<div class="page-head">
  <div><h2 class="mb-0"><%= t('admin.globalBlank') %></h2>
    <p class="muted small mb-0"><%= t('admin.globalBlankSub') %></p></div>
  <% if (sample) { %>
    <a class="btn" href="/r/<%= sample.public_id %>" target="_blank"><%- icon('eye',{size:16}) %> <%= t('admin.sample') %></a>
  <% } %>
</div>

<div class="grid sidebar-right">
  <div class="card">
    <form method="post" action="/admin/blank">
      <%- include('../partials/template-fields', { tpl: template, ph: null }) %>
      <button class="btn btn-primary btn-lg"><%- icon('check',{size:17}) %> <%= t('admin.saveBlank') %></button>
    </form>
  </div>

  <div class="col gap-3">
    <div class="card">
      <h4><%= t('admin.logo') %></h4>
      <div class="center card mb-2" style="background:#fbfdfd">
        <% if (template.logo_path) { %>
          <img src="/<%= template.logo_path %>" alt="Logotip" style="max-height:90px">
        <% } else { %>
          <div class="empty" style="padding:22px"><%- icon('image',{size:38}) %><div class="small"><%= t('profile.notUploaded') %></div></div>
        <% } %>
      </div>
      <form method="post" action="/admin/blank/logo" enctype="multipart/form-data">
        <div class="field"><input type="file" name="logo" accept="image/png,image/jpeg" required></div>
        <button class="btn btn-primary btn-sm btn-block"><%- icon('image',{size:15}) %> <%= t('admin.uploadLogo') %></button>
      </form>
      <% if (template.logo_path) { %>
        <form method="post" action="/admin/blank/logo" class="mt-1" data-confirm="<%= t('admin.deleteLogoConfirm') %>">
          <input type="hidden" name="remove" value="1">
          <button class="btn btn-danger btn-sm btn-block"><%- icon('trash',{size:14}) %> <%= t('common.delete') %></button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h4><%= t('admin.blankStructure') %></h4>
      <ol class="small muted" style="padding-left:18px;line-height:1.9;margin:0">
        <% t('tpl.structure').forEach(function (line) { %><li><%= line %></li><% }) %>
      </ol>
      <p class="hint mt-2"><%= t('admin.blankStructureNote') %></p>
    </div>

    <div class="card">
      <h4><%= t('admin.personalBlanks') %></h4>
      <p class="small muted"><%= t('admin.personalBlanksText') %></p>
      <a class="btn btn-sm btn-block" href="/admin/doctors"><%= t('admin.doctorsList') %></a>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
