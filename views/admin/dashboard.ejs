<%- include('../partials/app-head', { pageTitle: t('admin.title'), pageSub: fmt.longDate(fmt.toISODate()) }) %>

<div class="grid c4 mb-3">
  <div class="card stat accent">
    <div class="stat-icon"><%- icon('file',{size:19}) %></div>
    <div class="stat-label"><%= t('dash.daily') %></div>
    <div class="stat-value"><%= stats.daily %></div>
    <div class="stat-foot">
      <span class="delta <%= stats.dailyDiff > 0 ? 'up' : stats.dailyDiff < 0 ? 'down' : 'flat' %>"><%= stats.dailyDiff %>%</span>
      <span><%= t('dash.yesterday') %>: <%= stats.dailyPrev %></span>
    </div>
  </div>
  <div class="card stat">
    <div class="stat-icon"><%- icon('chart',{size:19}) %></div>
    <div class="stat-label"><%= t('dash.monthly') %></div>
    <div class="stat-value"><%= stats.monthly %></div>
    <div class="stat-foot"><span><%= t('dash.lastMonth') %>: <%= stats.monthlyPrev %></span></div>
  </div>
  <div class="card stat">
    <div class="stat-icon"><%- icon('users',{size:19}) %></div>
    <div class="stat-label"><%= t('dash.patients') %></div>
    <div class="stat-value"><%= stats.totalPatients %></div>
    <div class="stat-foot"><span><%= t('dash.thisMonthNew') %> +<%= stats.newPatientsMonth %></span></div>
  </div>
  <div class="card stat">
    <div class="stat-icon"><%- icon('eye',{size:19}) %></div>
    <div class="stat-label"><%= t('dash.rxViews') %></div>
    <div class="stat-value"><%= stats.views %></div>
    <div class="stat-foot"><span><%= t('dash.byPatients') %></span></div>
  </div>
</div>

<div class="grid sidebar-right">
  <div class="col gap-3">
    <div class="card">
      <div class="row between mb-2"><h3 class="mb-0"><%= t('dash.last14') %></h3>
        <span class="badge brand"><%= t('common.total') %>: <%= stats.series.reduce((a,b)=>a+b.value,0) %></span></div>
      <% const max = Math.max(1, ...stats.series.map(s=>s.value)); %>
      <div class="chart">
        <% stats.series.forEach(function (s, i) { %>
          <div class="bar <%= i === stats.series.length-1 ? 'today' : '' %>" title="<%= fmt.dmy(s.date) %>: <%= s.value %>">
            <span class="v"><%= s.value || '' %></span>
            <span class="fill" style="height:<%= Math.round((s.value/max)*100) %>%"></span>
            <span class="l"><%= s.label %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card flush">
      <div class="card-head"><h3><%= t('dash.doctorsActivity') %></h3>
        <a class="btn btn-sm btn-ghost" href="/admin/doctors"><%= t('dash.manage') %> <%- icon('chevronRight',{size:14}) %></a></div>
      <% if (doctors.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th><%= t('table.doctor') %></th><th class="hide-sm"><%= t('table.specialty') %></th><th class="num"><%= t('table.today') %></th>
              <th class="num"><%= t('common.total') %></th><th><%= t('table.stamp') %></th><th><%= t('common.status') %></th><th></th></tr></thead>
            <tbody>
              <% doctors.forEach(function (d) { %>
                <tr>
                  <td><div class="row gap-2"><span class="avatar sm"><%= fmt.initials(d.full_name) %></span>
                    <a class="rowlink" href="/admin/doctors/<%= d.id %>"><%= d.full_name %></a></div></td>
                  <td class="hide-sm small"><%= d.specialty || '—' %></td>
                  <td class="num"><%= d.rx_today %></td>
                  <td class="num strong"><%= d.rx_total %></td>
                  <td><span class="badge <%= d.stamp_path ? 'ok' : 'warn' %>"><%= d.stamp_path ? t('common.yes') : t('common.no') %></span></td>
                  <td><span class="badge <%= d.is_active ? 'ok' : 'danger' %>"><%= d.is_active ? t('common.active') : t('common.inactive') %></span></td>
                  <td class="right"><a class="btn btn-sm btn-ghost" href="/admin/doctors/<%= d.id %>"><%- icon('chevronRight',{size:15}) %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty"><%- icon('users',{size:46}) %><h3><%= t('admin.noDoctors') %></h3>
          <p><%= t('admin.noDoctorsText') %></p>
          <a class="btn btn-primary mt-2" href="/admin/doctors/new"><%- icon('plus',{size:16}) %> <%= t('admin.addDoctor') %></a></div>
      <% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h3><%= t('dash.recentRx') %></h3>
        <a class="btn btn-sm btn-ghost" href="/admin/prescriptions"><%= t('common.all') %> <%- icon('chevronRight',{size:14}) %></a></div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th><%= t('table.id') %></th><th><%= t('table.patient') %></th><th class="hide-sm"><%= t('table.doctor') %></th><th><%= t('table.date') %></th><th></th></tr></thead>
          <tbody>
            <% recent.forEach(function (r) { %>
              <tr>
                <td class="mono small nowrap"><%= r.pretty_id %></td>
                <td class="truncate" style="max-width:180px"><%= r.patient_name %></td>
                <td class="hide-sm small"><%= fmt.shortName(r.doctor_name) %></td>
                <td class="small nowrap"><%= fmt.dmy(r.visit_date) %></td>
                <td class="right"><a class="btn btn-sm btn-ghost" href="/r/<%= r.public_id %>"><%- icon('eye',{size:15}) %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col gap-3">
    <div class="card">
      <h4><%= t('dash.quickActions') %></h4>
      <div class="col gap-1">
        <a class="btn btn-primary btn-block" href="/admin/doctors/new"><%- icon('plus',{size:16}) %> <%= t('admin.addDoctor') %></a>
        <a class="btn btn-block" href="/admin/blank"><%- icon('edit',{size:16}) %> <%= t('nav.blank') %></a>
        <a class="btn btn-block" href="/admin/prescriptions"><%- icon('file',{size:16}) %> <%= t('nav.prescriptions') %></a>
        <a class="btn btn-block" href="/admin/telegram"><%- icon('send',{size:16}) %> <%= t('nav.telegram') %></a>
      </div>
    </div>

    <div class="card">
      <div class="row between mb-1"><h4 class="mb-0"><%= t('nav.telegram') %></h4>
        <span class="badge <%= tg.enabled ? 'ok' : 'warn' %>"><%= tg.enabled ? t('dash.enabled') : t('dash.disabled') %></span></div>
      <div class="stat-value" style="font-size:1.6rem"><%= tg.users %></div>
      <div class="small muted"><%= t('dash.registeredUsers') %></div>
      <a class="btn btn-sm mt-2 btn-block" href="/admin/telegram"><%= t('common.more') %></a>
    </div>

    <div class="card">
      <h4><%= t('dash.recentActions') %></h4>
      <div class="list" style="margin:0 -20px -20px">
        <% audits.forEach(function (a) { %>
          <div class="list-item" style="padding:9px 20px">
            <div class="grow" style="min-width:0">
              <div class="small truncate"><strong><%= a.full_name || t('dash.system') %></strong> — <%= a.action %></div>
              <div class="tiny muted"><%= fmt.dateTime(a.created_at) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
