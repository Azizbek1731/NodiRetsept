<%- include('../partials/app-head', { pageTitle: t('nav.doctors'), pageSub: String(doctors.length) }) %>

<div class="page-head">
  <div><h2 class="mb-0"><%= t('admin.doctorsTitle') %></h2>
    <p class="muted small mb-0"><%= t('admin.doctorsSubtitle') %></p></div>
  <a class="btn btn-primary" href="/admin/doctors/new"><%- icon('plus',{size:17}) %> <%= t('admin.addDoctor') %></a>
</div>

<div class="card mb-3">
  <form method="get" class="row wrap gap-2">
    <div class="grow" style="min-width:200px">
      <input type="search" name="q" value="<%= q %>" placeholder="<%= t('admin.doctorSearch') %>">
    </div>
    <button class="btn btn-primary"><%- icon('search',{size:16}) %> <%= t('common.search') %></button>
    <% if (q) { %><a class="btn btn-ghost" href="/admin/doctors"><%= t('common.clear') %></a><% } %>
  </form>
</div>

<div class="card flush">
  <% if (doctors.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= t('table.doctor') %></th><th><%= t('table.login') %></th><th class="hide-sm"><%= t('table.phone') %></th><th class="num"><%= t('table.rxCount') %></th>
          <th><%= t('table.stamp') %></th><th><%= t('table.blank') %></th><th><%= t('common.status') %></th><th></th></tr></thead>
        <tbody>
          <% doctors.forEach(function (d) { %>
            <tr>
              <td><div class="row gap-2"><span class="avatar sm"><%= fmt.initials(d.full_name) %></span>
                <span><a class="rowlink" href="/admin/doctors/<%= d.id %>"><%= d.full_name %></a>
                <div class="tiny muted"><%= d.specialty || '—' %></div></span></div></td>
              <td class="mono small"><%= d.username %></td>
              <td class="hide-sm small nowrap"><%= fmt.phoneFmt(d.phone) || '—' %></td>
              <td class="num strong"><%= d.rx_total %></td>
              <td><span class="badge <%= d.stamp_path ? 'ok' : 'warn' %>"><%= d.stamp_path ? t('common.yes') : t('common.no') %></span></td>
              <td><span class="badge <%= d.has_template ? 'brand' : '' %>"><%= d.has_template ? t('profile.blankCustom') : t('profile.blankGlobal') %></span></td>
              <td><span class="badge <%= d.is_active ? 'ok' : 'danger' %>"><%= d.is_active ? t('common.active') : t('common.inactive') %></span></td>
              <td class="right"><a class="btn btn-sm btn-soft" href="/admin/doctors/<%= d.id %>"><%- icon('edit',{size:14}) %> <%= t('nav.groupSetup') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty"><%- icon('users',{size:46}) %><h3><%= t('admin.doctorNotFound') %></h3>
      <a class="btn btn-primary mt-2" href="/admin/doctors/new"><%- icon('plus',{size:16}) %> <%= t('admin.addDoctor') %></a></div>
  <% } %>
</div>

<%- include('../partials/app-foot') %>
