<%- include('../partials/app-head', { pageTitle: t('patients.allTitle'), pageSub: t('patients.count', { n: total }) }) %>

<div class="card mb-3">
  <form method="get" class="row wrap gap-2">
    <div class="grow" style="min-width:200px">
      <input type="search" name="q" value="<%= q %>" placeholder="<%= t('patients.searchPlaceholder') %>"></div>
    <button class="btn btn-primary"><%- icon('search',{size:16}) %> <%= t('common.search') %></button>
    <% if (q) { %><a class="btn btn-ghost" href="/admin/patients"><%= t('common.clear') %></a><% } %>
  </form>
</div>

<div class="card flush">
  <% if (patients.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= t('table.patient') %></th><th><%= t('table.code') %></th><th class="hide-sm"><%= t('table.birthYear') %></th><th class="hide-sm"><%= t('table.phone') %></th>
          <th class="num"><%= t('table.rxCount') %></th><th class="hide-sm"><%= t('table.addedBy') %></th><th class="hide-sm"><%= t('table.lastVisit') %></th></tr></thead>
        <tbody>
          <% patients.forEach(function (p) { %>
            <tr>
              <td><div class="row gap-2"><span class="avatar sm"><%= fmt.initials(p.full_name) %></span>
                <span class="strong"><%= p.full_name %></span></div></td>
              <td class="mono small nowrap"><%= p.code || '—' %></td>
              <td class="hide-sm small"><%= p.birth_year || '—' %></td>
              <td class="hide-sm small nowrap"><%= fmt.phoneFmt(p.phone) || '—' %></td>
              <td class="num"><span class="badge <%= p.rx_count ? 'brand' : '' %>"><%= p.rx_count %></span></td>
              <td class="hide-sm small"><%= p.creator ? fmt.shortName(p.creator) : '—' %></td>
              <td class="hide-sm small nowrap"><%= p.last_visit ? fmt.dmy(p.last_visit) : '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager', { total, page, perPage, query: { q } }) %>
  <% } else { %>
    <div class="empty"><%- icon('users',{size:46}) %><h3><%= t('patients.notFound') %></h3></div>
  <% } %>
</div>

<%- include('../partials/app-foot') %>
