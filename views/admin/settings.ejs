<%- include('../partials/app-head', { pageTitle: t('nav.settings') }) %>

<div class="grid c4 mb-3">
  <div class="card stat"><div class="stat-icon"><%- icon('users',{size:19}) %></div>
    <div class="stat-label"><%= t('nav.doctors') %></div><div class="stat-value"><%= counts.doctors %></div></div>
  <div class="card stat"><div class="stat-icon"><%- icon('heart',{size:19}) %></div>
    <div class="stat-label"><%= t('nav.patients') %></div><div class="stat-value"><%= counts.patients %></div></div>
  <div class="card stat"><div class="stat-icon"><%- icon('file',{size:19}) %></div>
    <div class="stat-label"><%= t('nav.prescriptions') %></div><div class="stat-value"><%= counts.prescriptions %></div></div>
  <div class="card stat"><div class="stat-icon"><%- icon('send',{size:19}) %></div>
    <div class="stat-label">Telegram</div><div class="stat-value"><%= counts.telegram %></div></div>
</div>

<div class="grid sidebar-right">
  <div class="col gap-3">
    <div class="card">
      <h3><%= t('admin.sysConfig') %></h3>
      <p class="small muted"><%- t('admin.sysConfigHint') %></p>
      <div class="rx-kv">
        <div><span class="k"><%= t('admin.siteUrl') %></span><span class="v mono"><%= config.publicUrl %></span></div>
        <div><span class="k"><%= t('admin.port') %></span><span class="v mono"><%= config.port %></span></div>
        <div><span class="k"><%= t('admin.mode') %></span><span class="v"><%= config.env %></span></div>
        <div><span class="k"><%= t('nav.telegram') %></span><span class="v"><%= config.telegram ? t('dash.enabled') : t('dash.disabled') %></span></div>
        <div><span class="k"><%= t('admin.database') %></span><span class="v mono tiny"><%= config.dbPath %></span></div>
      </div>
      <div class="flash info mt-2"><%- icon('alert',{size:18}) %>
        <span><%- t('admin.publicUrlWarn') %></span></div>
    </div>

    <div class="card flush">
      <div class="card-head"><h3><%= t('admin.auditTitle') %></h3></div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th><%= t('table.time') %></th><th><%= t('table.user') %></th><th><%= t('table.action') %></th><th class="hide-sm"><%= t('table.object') %></th></tr></thead>
          <tbody>
            <% audits.forEach(function (a) { %>
              <tr>
                <td class="small nowrap"><%= fmt.dateTime(a.created_at) %></td>
                <td class="small"><%= a.full_name || t('dash.system') %></td>
                <td><span class="badge"><%= a.action %></span></td>
                <td class="hide-sm tiny muted"><%= a.entity || '' %> <%= a.entity_id || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col gap-3">
    <div class="card">
      <h4><%= t('admin.backupTitle') %></h4>
      <p class="small muted"><%= t('admin.backupText') %></p>
      <div class="copy-field"><input type="text" readonly value="<%= config.dbPath %>"></div>
      <p class="hint mt-2"><%- t('admin.backupHint') %></p>
    </div>
    <div class="card">
      <h4><%= t('admin.uploadsTitle') %></h4>
      <p class="small muted mb-1"><%- t('admin.uploadsText') %></p>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
