<%- include('../partials/app-head', { pageTitle: t('nav.telegram'), pageSub: String(total) }) %>

<div class="grid sidebar-right">
  <div class="col gap-3">
    <div class="card">
      <div class="row between wrap gap-2 mb-2">
        <h3 class="mb-0"><%= t('admin.botStatus') %></h3>
        <span class="badge <%= botInfo.running ? 'ok' : (enabled ? 'warn' : 'danger') %>">
          <%= botInfo.running ? t('admin.botRunning') : (enabled ? t('admin.botConnecting') : t('dash.disabled')) %>
        </span>
      </div>
      <div class="rx-kv">
        <div><span class="k"><%= t('admin.botAddress') %></span><span class="v">
          <% if (botInfo.username) { %>
            <a href="https://t.me/<%= botInfo.username %>" target="_blank" rel="noopener">@<%= botInfo.username %></a>
          <% } else { %>—<% } %></span></div>
        <div><span class="k"><%= t('admin.botToken') %></span><span class="v mono"><%= tokenTail || t('admin.botNotSet') %></span></div>
        <div><span class="k"><%= t('admin.botStarted') %></span><span class="v"><%= botInfo.startedAt ? fmt.dateTime(botInfo.startedAt) : '—' %></span></div>
        <div><span class="k"><%= t('admin.botError') %></span><span class="v"><%= botInfo.error || t('common.no') %></span></div>
      </div>
      <% if (!enabled) { %>
        <div class="flash error mt-2"><%- icon('alert',{size:18}) %>
          <span><%- t('admin.botEnvHint') %></span></div>
      <% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h3><%= t('admin.botUsers') %></h3><span class="badge"><%= total %></span></div>
      <% if (users.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th><%= t('table.user') %></th><th><%= t('table.phone') %></th><th class="hide-sm"><%= t('admin.botChatId') %></th>
              <th class="hide-sm"><%= t('admin.botRegistered') %></th><th class="hide-sm"><%= t('admin.botLastSeen') %></th></tr></thead>
            <tbody>
              <% users.forEach(function (u) { %>
                <tr>
                  <td><div class="row gap-2"><span class="avatar sm"><%= fmt.initials(u.first_name || 'TG') %></span>
                    <span><span class="strong"><%= u.first_name || '—' %></span>
                    <% if (u.username) { %><div class="tiny muted">@<%= u.username %></div><% } %></span></div></td>
                  <td class="small nowrap"><%= u.phone ? fmt.phoneFmt(u.phone) : '—' %></td>
                  <td class="hide-sm mono tiny"><%= u.chat_id %></td>
                  <td class="hide-sm small nowrap"><%= fmt.dmy(u.created_at) %></td>
                  <td class="hide-sm small nowrap"><%= u.last_seen_at ? fmt.dateTime(u.last_seen_at) : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty"><%- icon('send',{size:46}) %><h3><%= t('admin.botNoUsers') %></h3>
          <p><%- t('admin.botNoUsersText') %></p></div>
      <% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h3><%= t('admin.botSent') %></h3></div>
      <% if (sends.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th><%= t('nav.mRx') %></th><th><%= t('table.time') %></th><th class="hide-sm">Chat</th></tr></thead>
            <tbody>
              <% sends.forEach(function (s) { %>
                <tr>
                  <td class="mono small"><%= s.public_id ? ids.prettyId(s.public_id) : '—' %></td>
                  <td class="small nowrap"><%= fmt.dateTime(s.created_at) %></td>
                  <td class="hide-sm tiny muted"><%= (JSON.parse(s.meta || '{}').chat_id) || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %><div class="empty" style="padding:26px"><div class="small"><%= t('admin.botNotSent') %></div></div><% } %>
    </div>
  </div>

  <div class="col gap-3">
    <div class="card">
      <h4><%= t('admin.botHowTitle') %></h4>
      <ol class="small" style="padding-left:18px;line-height:1.9;margin:0;color:var(--ink-2)">
        <li><%- t('admin.botHow1') %></li>
        <li><%- t('admin.botHow2') %></li>
        <li><%- t('admin.botHow3') %></li>
        <li><%- t('admin.botHow4') %></li>
        <li><%- t('admin.botHow5') %></li>
      </ol>
      <hr>
      <p class="small muted mb-1"><%- t('admin.botMineNote') %></p>
    </div>
    <div class="card">
      <h4><%= t('admin.botDeepLink') %></h4>
      <p class="small muted"><%= t('admin.botDeepLinkText') %></p>
      <div class="copy-field">
        <input type="text" readonly value="https://t.me/<%= botInfo.username || 'bot' %>?start=NR-XXXXXXXX">
      </div>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
