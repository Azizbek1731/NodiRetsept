<%- include('../partials/app-head', { pageTitle: t('nav.dashboard'), pageSub: fmt.longDate(fmt.toISODate()) }) %>

<!-- Asosiy amal -->
<div class="card mb-3" style="background:linear-gradient(120deg,#0d2b33,#0e7c86);border:none;color:#fff">
  <div class="row between wrap gap-3">
    <div class="grow" style="min-width:240px">
      <h2 style="color:#fff;margin-bottom:4px"><%= t('dash.greeting', { name: fmt.shortName(currentUser.full_name) }) %></h2>
      <p style="color:rgba(255,255,255,.82);margin:0"><%- t('dash.todayCount', { n: stats.daily }) %></p>
    </div>
    <button class="btn btn-lg" data-rx-new style="background:#fff;color:var(--brand-dark);border-color:#fff">
      <%- icon('plus',{size:19}) %> <%= t('dash.writeRx') %>
    </button>
  </div>
</div>

<!-- Hisobotlar -->
<div class="grid c4 mb-3">
  <% const cards = [
      { label: t('dash.daily'), value: stats.daily, diff: stats.dailyDiff, note: t('dash.yesterday') + ': ' + stats.dailyPrev, ic: 'calendar', accent: true },
      { label: t('dash.weekly'), value: stats.weekly, diff: stats.weeklyDiff, note: t('dash.lastWeek') + ': ' + stats.weeklyPrev, ic: 'chart' },
      { label: t('dash.monthly'), value: stats.monthly, diff: stats.monthlyDiff, note: t('dash.lastMonth') + ': ' + stats.monthlyPrev, ic: 'activity' },
      { label: t('dash.patients'), value: stats.totalPatients, diff: null, note: t('dash.thisMonthNew') + ' +' + stats.newPatientsMonth, ic: 'users' }
     ]; %>
  <% cards.forEach(function (c) { %>
    <div class="card stat <%= c.accent ? 'accent' : '' %>">
      <div class="stat-icon"><%- icon(c.ic,{size:19}) %></div>
      <div class="stat-label"><%= c.label %></div>
      <div class="stat-value"><%= c.value %></div>
      <div class="stat-foot">
        <% if (c.diff !== null && c.diff !== undefined) { %>
          <span class="delta <%= c.diff > 0 ? 'up' : c.diff < 0 ? 'down' : 'flat' %>">
            <%- c.diff > 0 ? icon('arrowUp',{size:12}) : c.diff < 0 ? icon('arrowDown',{size:12}) : '' %><%= Math.abs(c.diff) %>%
          </span>
        <% } %>
        <span><%= c.note %></span>
      </div>
    </div>
  <% }) %>
</div>

<div class="grid sidebar-right">
  <div class="col gap-3">
    <!-- Grafik -->
    <div class="card">
      <div class="row between mb-2">
        <h3 class="mb-0"><%= t('dash.last14') %></h3>
        <span class="badge brand"><%= t('common.total') %>: <%= stats.series.reduce((a,b)=>a+b.value,0) %></span>
      </div>
      <% const max = Math.max(1, ...stats.series.map(s=>s.value)); %>
      <div class="chart">
        <% stats.series.forEach(function (s, i) { %>
          <div class="bar <%= i === stats.series.length-1 ? 'today' : '' %>" title="<%= fmt.dmy(s.date) %>: <%= s.value %>">
            <span class="v"><%= s.value || '' %></span>
            <span class="fill" style="height:<%= Math.round((s.value / max) * 100) %>%"></span>
            <span class="l"><%= s.label %></span>
          </div>
        <% }) %>
      </div>
      <hr>
      <div class="row between mb-2"><h3 class="mb-0"><%= t('dash.monthlyTrend') %></h3></div>
      <% const maxM = Math.max(1, ...stats.months.map(s=>s.value)); %>
      <div class="chart" style="height:98px">
        <% stats.months.forEach(function (s, i) { %>
          <div class="bar <%= i === stats.months.length-1 ? 'today' : '' %>" title="<%= fmt.monthShort(s.month) %>: <%= s.value %>">
            <span class="v"><%= s.value || '' %></span>
            <span class="fill" style="height:<%= Math.round((s.value / maxM) * 100) %>%"></span>
            <span class="l"><%= fmt.monthShort(s.month) %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- So'nggi retseptlar -->
    <div class="card flush">
      <div class="card-head">
        <h3><%= t('dash.recentRx') %></h3>
        <a class="btn btn-sm btn-ghost" href="/prescriptions"><%= t('common.all') %> <%- icon('chevronRight',{size:14}) %></a>
      </div>
      <% if (recent.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th><%= t('table.id') %></th><th><%= t('table.patient') %></th><th><%= t('table.diagnosis') %></th><th><%= t('table.date') %></th><th class="num"><%= t('table.drugs') %></th><th></th></tr></thead>
            <tbody>
              <% recent.forEach(function (r) { %>
                <tr>
                  <td class="mono small nowrap"><%= r.pretty_id %></td>
                  <td><a class="rowlink" href="/patients/<%= r.patient_id %>"><%= r.patient_name %></a>
                      <div class="tiny muted"><%= r.birth_year || '' %></div></td>
                  <td class="truncate" style="max-width:220px"><%= r.diagnosis || '—' %></td>
                  <td class="nowrap small"><%= fmt.dmy(r.visit_date) %></td>
                  <td class="num"><%= r.item_count %></td>
                  <td class="right nowrap">
                    <a class="btn btn-sm btn-ghost" href="/r/<%= r.public_id %>" title="<%= t('common.view') %>"><%- icon('eye',{size:15}) %></a>
                    <a class="btn btn-sm btn-ghost" href="/r/<%= r.public_id %>/pdf" title="PDF"><%- icon('download',{size:15}) %></a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty"><%- icon('file',{size:46}) %><h3><%= t('dash.noRxTitle') %></h3>
          <p><%= t('dash.noRxText') %></p></div>
      <% } %>
    </div>
  </div>

  <!-- Yon ustun -->
  <div class="col gap-3">
    <div class="card flush">
      <div class="card-head"><h3><%= t('dash.todayVisits') %></h3><span class="badge"><%= todays.length %></span></div>
      <% if (todays.length) { %>
        <div class="list">
          <% todays.slice(0,7).forEach(function (r) { %>
            <a class="list-item" href="/r/<%= r.public_id %>">
              <span class="avatar sm"><%= fmt.initials(r.patient_name) %></span>
              <span class="grow" style="min-width:0">
                <span class="ttl truncate"><%= r.patient_name %></span>
                <span class="sub truncate"><%= r.diagnosis || t('dash.noDxGiven') %></span>
              </span>
              <%- icon('chevronRight',{size:16}) %>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty" style="padding:26px 16px"><%- icon('clock',{size:38}) %>
          <div class="small"><%= t('dash.noTodayRx') %></div></div>
      <% } %>
    </div>

    <div class="card">
      <h3><%= t('dash.topDx') %></h3>
      <p class="tiny muted mt-0"><%= t('dash.thisMonth') %></p>
      <% if (stats.topDiagnoses.length) { %>
        <div class="rank-list">
          <% const mx = Math.max(...stats.topDiagnoses.map(d=>d.n)); %>
          <% stats.topDiagnoses.forEach(function (d, i) { %>
            <div class="rank-item">
              <span class="rk"><%= i+1 %></span>
              <span class="grow truncate" title="<%= d.diagnosis %>"><%= d.diagnosis %></span>
              <span class="bar-bg" style="max-width:60px"><i style="width:<%= Math.round(d.n/mx*100) %>%"></i></span>
              <span class="strong small"><%= d.n %></span>
            </div>
          <% }) %>
        </div>
      <% } else { %><p class="small muted mb-0"><%= t('dash.noData') %></p><% } %>
    </div>

    <div class="card">
      <h3><%= t('dash.topDrugs') %></h3>
      <p class="tiny muted mt-0"><%= t('dash.thisMonth') %></p>
      <% if (stats.topDrugs.length) { %>
        <div class="rank-list">
          <% const mx2 = Math.max(...stats.topDrugs.map(d=>d.n)); %>
          <% stats.topDrugs.forEach(function (d, i) { %>
            <div class="rank-item">
              <span class="rk"><%= i+1 %></span>
              <span class="grow truncate" title="<%= d.drug_name %>"><%= d.drug_name %></span>
              <span class="bar-bg" style="max-width:60px"><i style="width:<%= Math.round(d.n/mx2*100) %>%"></i></span>
              <span class="strong small"><%= d.n %></span>
            </div>
          <% }) %>
        </div>
      <% } else { %><p class="small muted mb-0"><%= t('dash.noData') %></p><% } %>
    </div>

    <div class="card center">
      <div class="avatar lg" style="margin:0 auto 10px"><%- icon('qr',{size:24}) %></div>
      <h4><%= t('dash.howTitle') %></h4>
      <p class="small muted"><%- t('dash.howText') %></p>
      <a class="btn btn-sm" href="/" target="_blank"><%- icon('external',{size:14}) %> <%= t('dash.howLink') %></a>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
