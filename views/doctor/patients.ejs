<%- include('../partials/app-head', { pageTitle: t('nav.patients'), pageSub: t('patients.count', { n: total }) }) %>

<div class="page-head">
  <div>
    <h2 class="mb-0"><%= t('nav.patients') %></h2>
    <p class="muted small mb-0"><%= t('patients.subtitle') %></p>
  </div>
  <button class="btn btn-primary" data-rx-new><%- icon('plus',{size:17}) %> <%= t('dash.writeRx') %></button>
</div>

<div class="card mb-3">
  <form method="get" class="row wrap gap-2">
    <div class="grow" style="min-width:200px">
      <input type="search" name="q" value="<%= q %>" placeholder="<%= t('patients.searchPlaceholder') %>">
    </div>
    <input type="hidden" name="scope" value="<%= listScope %>">
    <button class="btn btn-primary"><%- icon('search',{size:16}) %> <%= t('common.search') %></button>
    <% if (q) { %><a class="btn btn-ghost" href="/patients?scope=<%= listScope %>"><%= t('common.clear') %></a><% } %>
  </form>
  <div class="row gap-1 mt-2">
    <a class="chip <%= listScope === 'mine' ? 'active' : '' %>" href="/patients?scope=mine<%= q ? '&q='+encodeURIComponent(q) : '' %>"><%= t('patients.mine') %></a>
    <a class="chip <%= listScope === 'all' ? 'active' : '' %>" href="/patients?scope=all<%= q ? '&q='+encodeURIComponent(q) : '' %>"><%= t('patients.all') %></a>
  </div>
</div>

<div class="card flush">
  <% if (patients.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th><%= t('table.patient') %></th><th><%= t('table.code') %></th><th class="hide-sm"><%= t('table.birthYear') %></th><th class="hide-sm"><%= t('table.phone') %></th>
              <th class="num"><%= t('table.rxCount') %></th><th class="hide-sm"><%= t('table.lastVisit') %></th><th></th></tr>
        </thead>
        <tbody>
          <% patients.forEach(function (p) { %>
            <tr>
              <td>
                <div class="row gap-2">
                  <span class="avatar sm"><%= fmt.initials(p.full_name) %></span>
                  <a class="rowlink" href="/patients/<%= p.id %>"><%= p.full_name %></a>
                </div>
              </td>
              <td class="mono small nowrap"><%= p.code || '—' %></td>
              <td class="hide-sm small"><%= p.birth_year || '—' %><% if (fmt.age(p.birth_year)) { %>
                  <span class="muted">(<%= fmt.age(p.birth_year) %>)</span><% } %></td>
              <td class="hide-sm small nowrap"><%= fmt.phoneFmt(p.phone) || '—' %></td>
              <td class="num"><span class="badge <%= p.rx_count ? 'brand' : '' %>"><%= p.rx_count %></span></td>
              <td class="hide-sm small nowrap"><%= p.last_visit ? fmt.dmy(p.last_visit) : '—' %></td>
              <td class="right nowrap">
                <button class="btn btn-sm btn-soft" data-rx-new
                  data-patient='<%- JSON.stringify({ id: p.id, full_name: p.full_name, birth_year: p.birth_year, gender: p.gender, phone: p.phone, code: p.code, age: fmt.age(p.birth_year) }) %>'>
                  <%- icon('rx',{size:14}) %> <span class="hide-sm"><%= t('nav.mRx') %></span>
                </button>
                <a class="btn btn-sm btn-ghost" href="/patients/<%= p.id %>"><%- icon('chevronRight',{size:15}) %></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pager', { total, page, perPage, query: { q, scope: listScope } }) %>
  <% } else { %>
    <div class="empty">
      <%- icon('users',{size:46}) %>
      <h3><%= q ? t('patients.emptyFound') : t('patients.emptyList') %></h3>
      <p><%= q ? t('patients.emptyFoundText') : t('patients.emptyListText') %></p>
      <button class="btn btn-primary mt-2" data-rx-new><%- icon('plus',{size:16}) %> <%= t('dash.writeRx') %></button>
    </div>
  <% } %>
</div>

<%- include('../partials/app-foot') %>
