<%- include('../partials/app-head', { pageTitle: t('profile.title') }) %>

<div class="grid sidebar-right">
  <div class="col gap-3">
    <!-- Shaxsiy ma'lumotlar -->
    <div class="card">
      <h3><%= t('profile.personal') %></h3>
      <p class="small muted"><%= t('profile.personalHint') %></p>
      <form method="post" action="/profile">
        <div class="form-grid">
          <div class="field">
            <label for="full_name"><%= t('profile.fio') %> <span class="req">*</span></label>
            <input type="text" id="full_name" name="full_name" value="<%= doctor.full_name %>" required>
          </div>
          <div class="field">
            <label for="phone"><%= t('profile.phone') %></label>
            <input type="tel" id="phone" name="phone" value="<%= fmt.phoneFmt(doctor.phone) %>" placeholder="+998 90 123 45 67">
          </div>
          <div class="field">
            <label for="specialty"><%= t('profile.specialty') %></label>
            <input type="text" id="specialty" name="specialty" value="<%= doctor.specialty || '' %>" placeholder="Nevropatolog">
          </div>
          <div class="field">
            <label for="license_number"><%= t('profile.license') %></label>
            <input type="text" id="license_number" name="license_number" value="<%= doctor.license_number || '' %>">
          </div>
          <div class="field">
            <label for="room"><%= t('profile.room') %></label>
            <input type="text" id="room" name="room" value="<%= doctor.room || '' %>" placeholder="204-xona">
          </div>
        </div>
        <button class="btn btn-primary"><%- icon('check',{size:16}) %> <%= t('common.save') %></button>
      </form>
    </div>

    <!-- Pechat va imzo -->
    <div class="card">
      <h3><%= t('profile.mediaTitle') %></h3>
      <p class="small muted"><%= t('profile.mediaHint') %></p>
      <div class="grid c2 mb-2">
        <div class="center card" style="background:#fbfdfd">
          <div class="label mb-1"><%= t('profile.stamp') %></div>
          <% if (doctor.stamp_path) { %>
            <img src="/<%= doctor.stamp_path %>" alt="Pechat" style="max-height:110px">
          <% } else { %>
            <div class="empty" style="padding:20px"><%- icon('stamp',{size:38}) %><div class="small"><%= t('profile.notUploaded') %></div></div>
          <% } %>
        </div>
        <div class="center card" style="background:#fbfdfd">
          <div class="label mb-1"><%= t('profile.signature') %></div>
          <% if (doctor.signature_path) { %>
            <img src="/<%= doctor.signature_path %>" alt="Imzo" style="max-height:70px">
          <% } else { %>
            <div class="empty" style="padding:20px"><%- icon('edit',{size:38}) %><div class="small"><%= t('profile.notUploaded') %></div></div>
          <% } %>
        </div>
      </div>
      <form method="post" action="/profile/media" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field"><label for="stamp"><%= t('profile.stampFile') %></label><input type="file" id="stamp" name="stamp" accept="image/png,image/jpeg"></div>
          <div class="field"><label for="signature"><%= t('profile.signatureFile') %></label><input type="file" id="signature" name="signature" accept="image/png,image/jpeg"></div>
        </div>
        <button class="btn btn-primary"><%- icon('image',{size:16}) %> <%= t('common.upload') %></button>
      </form>
    </div>

    <!-- Ko'rinish va til -->
    <div class="card">
      <h3><%= t('appearance.title') %></h3>
      <p class="small muted"><%= t('appearance.subtitle') %></p>
      <%- include('../partials/appearance', { compact: false }) %>
    </div>

    <!-- Parol -->
    <div class="card">
      <h3><%= t('profile.passwordTitle') %></h3>
      <form method="post" action="/profile/password">
        <div class="form-grid">
          <div class="field"><label for="current"><%= t('profile.current') %></label>
            <input type="password" id="current" name="current" required autocomplete="current-password"></div>
          <div class="field"><label for="password"><%= t('profile.new') %></label>
            <input type="password" id="password" name="password" required minlength="6" autocomplete="new-password"></div>
          <div class="field"><label for="confirm"><%= t('profile.confirm') %></label>
            <input type="password" id="confirm" name="confirm" required minlength="6" autocomplete="new-password"></div>
        </div>
        <button class="btn btn-dark"><%- icon('key',{size:16}) %> <%= t('profile.updatePassword') %></button>
      </form>
    </div>
  </div>

  <div class="col gap-3">
    <div class="card center">
      <div class="avatar lg" style="margin:0 auto 10px"><%= fmt.initials(doctor.full_name) %></div>
      <h3 class="mb-0"><%= doctor.full_name %></h3>
      <p class="small muted"><%= doctor.specialty || (doctor.role === 'admin' ? t('profile.administrator') : t('profile.doctorRole')) %></p>
      <div class="row gap-1" style="justify-content:center"><span class="badge brand">@<%= doctor.username %></span>
        <span class="badge <%= doctor.is_active ? 'ok' : 'danger' %>"><%= doctor.is_active ? t('common.active') : t('common.inactive') %></span></div>
      <hr>
      <div class="grid c3 center">
        <div><div class="strong" style="font-size:1.3rem"><%= stats.daily %></div><div class="tiny muted"><%= t('profile.todayShort') %></div></div>
        <div><div class="strong" style="font-size:1.3rem"><%= stats.monthly %></div><div class="tiny muted"><%= t('profile.monthShort') %></div></div>
        <div><div class="strong" style="font-size:1.3rem"><%= stats.totalRx %></div><div class="tiny muted"><%= t('profile.totalShort') %></div></div>
      </div>
    </div>

    <div class="card">
      <h4><%= t('profile.blankTitle') %></h4>
      <p class="small muted"><%= t('profile.blankYours') %>
        <strong><%= template.is_custom ? t('profile.blankCustom') : t('profile.blankGlobal') %></strong></p>
      <div class="rx-kv">
        <div><span class="k"><%= t('admin.clinic') %></span><span class="v"><%= template.clinic_name || '—' %></span></div>
        <div><span class="k"><%= t('common.address') %></span><span class="v"><%= template.address || '—' %></span></div>
        <div><span class="k"><%= t('common.phone') %></span><span class="v"><%= fmt.phoneFmt(template.phone) || '—' %></span></div>
      </div>
      <p class="hint mt-2"><%= t('profile.blankHint') %></p>
    </div>

    <div class="card">
      <h4><%= t('profile.account') %></h4>
      <div class="rx-kv">
        <div><span class="k"><%= t('table.login') %></span><span class="v mono"><%= doctor.username %></span></div>
        <div><span class="k"><%= t('profile.created') %></span><span class="v"><%= fmt.dmy(doctor.created_at) %></span></div>
        <div><span class="k"><%= t('profile.lastLogin') %></span><span class="v"><%= doctor.last_login_at ? fmt.dateTime(doctor.last_login_at) : '—' %></span></div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/app-foot') %>
