<%- include('partials/head') %>
<div class="auth-card">
  <div class="brandline">
    <img class="logo" src="/static/img/logo-mark.svg" alt="NodiRetsept" width="42" height="42">
    <span><span class="nm">NodiRetsept</span><small><%= t('auth.subtitle') %></small></span>
  </div>

  <% if (error) { %>
    <div class="flash error"><%- icon('alert',{size:18}) %><span><%= error %></span></div>
  <% } %>

  <form method="post" action="/login" autocomplete="on">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field">
      <label for="username"><%= t('auth.login') %></label>
      <input type="text" id="username" name="username" value="<%= username %>" required autofocus
             autocapitalize="none" autocomplete="username" placeholder="<%= t('auth.loginPlaceholder') %>">
    </div>
    <div class="field">
      <label for="password"><%= t('auth.password') %></label>
      <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-lg btn-block mt-1"><%= t('auth.submit') %></button>
  </form>

  <hr>
  <%- include('partials/appearance', { compact: true }) %>
  <div class="auth-hint">
    <%= t('auth.patientQ') %> <a href="/"><%= t('auth.patientLink') %></a>
  </div>
</div>
<div id="toasts"></div>
<script src="/static/js/app.js"></script>
</body></html>
