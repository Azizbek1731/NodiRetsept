<%- include('partials/head') %>
<div class="auth-card">
  <div class="brandline">
    <span class="logo"><%- icon('rx', {size:23}) %></span>
    <span><span class="nm">NodiRetsept</span><small>Shifokor va administrator kabineti</small></span>
  </div>

  <% if (error) { %>
    <div class="flash error"><%- icon('alert',{size:18}) %><span><%= error %></span></div>
  <% } %>

  <form method="post" action="/login" autocomplete="on">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field">
      <label for="username">Login</label>
      <input type="text" id="username" name="username" value="<%= username %>" required autofocus
             autocapitalize="none" autocomplete="username" placeholder="Masalan: nodira">
    </div>
    <div class="field">
      <label for="password">Parol</label>
      <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
    </div>
    <button class="btn btn-primary btn-lg btn-block mt-1">Kirish</button>
  </form>

  <div class="auth-hint">
    Bemormisiz? <a href="/">Retseptni ID yoki QR orqali toping</a>
  </div>
</div>
<div id="toasts"></div>
<script src="/static/js/app.js"></script>
</body></html>
