<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0e7c86" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d181d" media="(prefers-color-scheme: dark)">
<script>
  /* Saqlangan mavzu va matn o'lchamini CSS yuklanishidan oldin qo'llaymiz —
     aks holda sahifa bir lahza noto'g'ri rangda ko'rinib ketadi. */
  (function () {
    try {
      var d = document.documentElement, s = window.localStorage;
      var t = s.getItem('nr_theme');
      if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
      var z = s.getItem('nr_textsize');
      if (z === 'large' || z === 'xlarge') d.setAttribute('data-textsize', z);
    } catch (e) { /* localStorage o'chirilgan bo'lishi mumkin */ }
  })();
</script>
<meta name="description" content="<%= t('meta.description') %>">
<title><%= title %> · NodiRetsept</title>
<link rel="stylesheet" href="/static/css/app.css">
<link rel="icon" type="image/svg+xml" href="/static/img/logo-mark.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/static/img/icon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/static/img/icon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/static/img/apple-touch-icon.png">
<link rel="manifest" href="/static/site.webmanifest">

<!-- Ijtimoiy tarmoqlarda havola ko'rinishi -->
<meta property="og:site_name" content="NodiRetsept">
<meta property="og:type" content="website">
<meta property="og:locale" content="<%= { ru: 'ru_RU', en: 'en_US', 'uz-Cyrl': 'uz_Cyrl_UZ' }[locale] || 'uz_UZ' %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= t('meta.ogDescription') %>">
<meta property="og:image" content="<%= publicUrl %>/static/img/og-image.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="<%= publicUrl %><%= currentPath %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= t('meta.ogDescription') %>">
<meta name="twitter:image" content="<%= publicUrl %>/static/img/og-image.jpg">
</head>
<body class="<%= bodyClass || '' %>">
