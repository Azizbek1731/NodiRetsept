<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0e7c86">
<meta name="description" content="NodiRetsept — shifokor yozgan retseptni QR kod yoki ID orqali onlayn olish tizimi.">
<title><%= title %> · NodiRetsept</title>
<link rel="stylesheet" href="/static/css/app.css">
<link rel="icon" type="image/svg+xml" href="/static/img/logo-mark.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/static/img/icon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/static/img/icon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/static/img/apple-touch-icon.png">
<link rel="manifest" href="/static/site.webmanifest">

<!-- Ijtimoiy tarmoqlarda havola ko'rinishi -->
<meta property="og:site_name" content="NodiRetsept">
<meta property="og:type" content="website">
<meta property="og:locale" content="uz_UZ">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="Shifokor yozgan retseptni QR kod yoki ID orqali onlayn oling va PDF sifatida yuklab oling.">
<meta property="og:image" content="<%= publicUrl %>/static/img/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="<%= publicUrl %><%= currentPath %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="Shifokor yozgan retseptni QR kod yoki ID orqali onlayn oling.">
<meta name="twitter:image" content="<%= publicUrl %>/static/img/og-image.png">
</head>
<body class="<%= bodyClass || '' %>">
