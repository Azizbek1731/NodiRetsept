<!-- ══ Retsept yozish / tahrirlash oynasi ══ -->
<div class="modal-backdrop" id="rxModal" role="dialog" aria-modal="true" aria-labelledby="rxModalTitle">
  <div class="modal lg">
    <div class="modal-head">
      <span class="avatar" style="background:var(--brand);color:#fff;border-color:transparent"><%- icon('rx',{size:19}) %></span>
      <div class="grow">
        <h2 id="rxModalTitle"><%= t('editor.newTitle') %></h2>
        <div class="sub" id="rxModalSub"><%= t('editor.subtitle') %></div>
      </div>
      <button class="btn btn-ghost btn-icon" data-rx-close aria-label="<%= t('common.close') %>"><%- icon('x',{size:19}) %></button>
    </div>

    <div class="modal-body">
      <!-- ── Forma ── -->
      <form id="rxForm" novalidate>
        <input type="hidden" name="prescription_id" id="rxId">

        <!-- Bemor tanlash -->
        <fieldset>
          <legend><%= t('editor.step1') %></legend>
          <div id="patientPicked" class="hide mb-2">
            <div class="selected-patient">
              <span class="avatar" id="ppAvatar">—</span>
              <div class="grow">
                <div class="strong" id="ppName">—</div>
                <div class="small muted" id="ppMeta">—</div>
              </div>
              <button type="button" class="btn btn-sm" id="ppChange"><%= t('editor.change') %></button>
            </div>
            <input type="hidden" name="patient_id" id="patientId">
          </div>

          <div id="patientSearchWrap">
            <div class="field picker" style="margin-bottom:6px">
              <label for="patientSearch"><%= t('editor.searchPatient') %> <span class="req">*</span></label>
              <input type="text" id="patientSearch" autocomplete="off" placeholder="<%= t('editor.searchPlaceholder') %>">
              <div class="picker-results" id="patientResults"></div>
            </div>
            <div class="hint"><%= t('editor.searchHint') %></div>
          </div>

          <!-- Yangi bemor -->
          <div id="newPatientBox" class="hide card mt-2" style="background:#fbfdfd">
            <div class="row between mb-2">
              <h4 class="mb-0"><%= t('editor.newPatient') %></h4>
              <button type="button" class="btn btn-ghost btn-sm" id="npCancel"><%- icon('x',{size:15}) %> <%= t('common.cancel') %></button>
            </div>
            <div class="form-grid">
              <div class="field">
                <label for="npName"><%= t('editor.npName') %> <span class="req">*</span></label>
                <input type="text" id="npName" placeholder="<%= t('editor.npNamePlaceholder') %>">
              </div>
              <div class="field">
                <label for="npYear"><%= t('editor.npYear') %> <span class="req">*</span></label>
                <input type="number" id="npYear" min="1900" max="<%= new Date().getFullYear() %>" placeholder="1990" inputmode="numeric">
              </div>
              <div class="field">
                <label for="npGender"><%= t('editor.npGender') %></label>
                <select id="npGender"><option value="">—</option><% editor.genders.forEach(function(g){ %><option><%= g %></option><% }) %></select>
              </div>
              <div class="field">
                <label for="npPhone"><%= t('editor.npPhone') %></label>
                <input type="tel" id="npPhone" placeholder="+998 90 123 45 67">
              </div>
            </div>
            <div class="field">
              <label for="npAddress"><%= t('editor.npAddress') %></label>
              <input type="text" id="npAddress" placeholder="<%= t('editor.npAddressPlaceholder') %>">
            </div>
            <div class="row end">
              <button type="button" class="btn btn-primary" id="npSave"><%- icon('check',{size:16}) %> <%= t('editor.npSave') %></button>
            </div>
          </div>
        </fieldset>

        <!-- Blanka -->
        <fieldset>
          <legend><%= t('editor.step2') %></legend>
          <div class="form-grid">
            <div class="field">
              <label for="rxDate"><%= t('editor.visitDate') %> <span class="req">*</span></label>
              <input type="date" id="rxDate" name="visit_date" value="<%= editor.today %>">
            </div>
            <% if (editor.canPickDoctor) { %>
            <div class="field">
              <label for="rxDoctor"><%= t('editor.doctorSelect') %></label>
              <select id="rxDoctor" name="doctor_id">
                <% editor.doctors.forEach(function(d){ %>
                  <option value="<%= d.id %>"><%= d.full_name %><%= d.specialty ? ' — ' + d.specialty : '' %></option>
                <% }) %>
              </select>
            </div>
            <% } %>
          </div>
          <div class="field">
            <label for="rxComplaints"><%= t('editor.complaints') %></label>
            <textarea id="rxComplaints" name="complaints" rows="2" placeholder="<%= t('editor.complaintsPlaceholder') %>"></textarea>
          </div>
          <div class="form-grid dx">
            <div class="field">
              <label for="rxDiagnosis"><%= t('editor.diagnosis') %> <span class="req">*</span></label>
              <input type="text" id="rxDiagnosis" name="diagnosis" placeholder="<%= t('editor.diagnosisPlaceholder') %>">
            </div>
            <div class="field">
              <label for="rxIcd"><%= t('editor.icd') %></label>
              <input type="text" id="rxIcd" name="icd10" placeholder="J06.9" style="text-transform:uppercase">
            </div>
          </div>
        </fieldset>

        <!-- Dorilar -->
        <fieldset>
          <legend><%= t('editor.step3') %></legend>
          <div id="drugList"></div>
          <button type="button" class="btn btn-soft btn-block" id="addDrug"><%- icon('plus',{size:16}) %> <%= t('editor.addDrug') %></button>
        </fieldset>

        <!-- Fizioterapiya va tavsiyalar -->
        <fieldset>
          <legend><%= t('editor.step4') %></legend>
          <div class="field">
            <label for="rxPhysio"><%= t('editor.physio') %></label>
            <textarea id="rxPhysio" name="physiotherapy" rows="2" placeholder="<%= t('editor.physioPlaceholder') %>"></textarea>
            <div class="suggest-row">
              <% editor.physioSuggest.forEach(function(s){ %>
                <button type="button" data-append="#rxPhysio" data-text="<%= s %>"><%= s %></button>
              <% }) %>
            </div>
          </div>
          <div class="field">
            <label for="rxRecommend"><%= t('editor.recommendations') %></label>
            <textarea id="rxRecommend" name="recommendations" rows="2" placeholder="<%= t('editor.recommendationsPlaceholder') %>"></textarea>
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="rxNext"><%= t('editor.nextVisit') %></label>
              <input type="date" id="rxNext" name="next_visit">
            </div>
          </div>
        </fieldset>

        <!-- Shifokor -->
        <fieldset style="margin-bottom:0">
          <legend><%= t('editor.step5') %></legend>
          <div class="card" style="background:#fbfdfd;padding:14px">
            <div class="row gap-2">
              <span class="avatar"><%= fmt.initials(currentUser.full_name) %></span>
              <div class="grow">
                <div class="strong"><%= currentUser.full_name %></div>
                <div class="small muted">
                  <%= currentUser.specialty || t('profile.doctorRole') %><% if (currentUser.phone) { %> · <%= fmt.phoneFmt(currentUser.phone) %><% } %>
                </div>
              </div>
              <span class="badge <%= currentUser.stamp_path ? 'ok' : 'warn' %>">
                <%- icon('stamp',{size:13}) %> <%= currentUser.stamp_path ? t('editor.stampOk') : t('editor.stampMissing') %>
              </span>
            </div>
            <% if (!currentUser.stamp_path && currentUser.role === 'doctor') { %>
              <div class="hint mt-1"><%- t('editor.stampHint') %></div>
            <% } %>
          </div>
        </fieldset>

        <div class="error-text mt-2 hide" id="rxError"></div>
      </form>

      <!-- ── Muvaffaqiyat ── -->
      <div id="rxSuccess" class="hide success-panel">
        <div class="mb-2"><span class="badge ok"><%- icon('checkCircle',{size:14}) %> <%= t('editor.savedBadge') %></span></div>
        <div class="qr-box"><img id="okQr" alt="QR"></div>
        <div class="idbig" id="okId">—</div>
        <div class="small muted"><%= t('editor.qrHint') %></div>
        <div class="copy-field">
          <input type="text" id="okLink" readonly>
          <button type="button" class="btn btn-sm" id="okCopy"><%- icon('copy',{size:14}) %> <%= t('common.copy') %></button>
        </div>
        <div class="rx-actions mt-3">
          <a class="btn btn-primary" id="okView" target="_blank"><%- icon('eye',{size:16}) %> <%= t('editor.openRx') %></a>
          <a class="btn" id="okPdf"><%- icon('download',{size:16}) %> <%= t('rx.downloadPdf') %></a>
          <a class="btn" id="okPrint" target="_blank"><%- icon('print',{size:16}) %> <%= t('common.print') %></a>
        </div>
      </div>
    </div>

    <div class="modal-foot">
      <div class="grow small muted hide-sm" id="rxFootHint"><%= t('editor.footHint') %></div>
      <button type="button" class="btn" data-rx-close><%= t('common.close') %></button>
      <button type="button" class="btn btn-primary" id="rxSave"><%- icon('check',{size:16}) %> <%= t('editor.submit') %></button>
      <button type="button" class="btn btn-primary hide" id="rxAgain"><%- icon('plus',{size:16}) %> <%= t('editor.again') %></button>
    </div>
  </div>
</div>

<!-- Dori qatori shabloni -->
<template id="drugTemplate">
  <div class="drug-row" data-drug-row>
    <div class="drug-head">
      <span class="drug-num">1</span>
      <div class="grow strong small"><%= t('editor.drugItem') %></div>
      <button type="button" class="btn btn-ghost btn-sm" data-drug-remove title="<%= t('editor.removeDrug') %>"><%- icon('trash',{size:15}) %></button>
    </div>
    <div class="grid-3">
      <div class="field picker">
        <label><%= t('editor.drugName') %> <span class="req">*</span></label>
        <input type="text" data-f="drug_name" autocomplete="off" placeholder="<%= t('editor.drugNamePlaceholder') %>">
        <div class="picker-results" data-drug-results></div>
      </div>
      <div class="field">
        <label><%= t('editor.strength') %></label>
        <input type="text" data-f="strength" placeholder="500 mg">
      </div>
      <div class="field">
        <label><%= t('editor.form') %></label>
        <input type="text" data-f="form" list="formList" placeholder="tab.">
      </div>
    </div>
    <div class="grid-4">
      <div class="field">
        <label><%= t('editor.quantity') %></label>
        <input type="text" data-f="quantity" placeholder="20" inputmode="numeric">
      </div>
      <div class="field">
        <label><%= t('editor.dose') %></label>
        <input type="text" data-f="dose" placeholder="<%= t('editor.dosePlaceholder') %>">
      </div>
      <div class="field">
        <label><%= t('editor.route') %></label>
        <input type="text" data-f="route" list="routeList" placeholder="<%= editor.routes[0] || '' %>">
      </div>
      <div class="field">
        <label><%= t('editor.frequency') %></label>
        <input type="text" data-f="frequency" list="freqList" placeholder="<%= editor.frequencies[2] || '' %>">
      </div>
    </div>
    <div class="grid-3">
      <div class="field">
        <label><%= t('editor.duration') %></label>
        <input type="text" data-f="duration" list="durList" placeholder="<%= editor.durations[2] || '' %>">
      </div>
      <div class="field" style="grid-column:span 2">
        <label><%= t('editor.instructions') %></label>
        <input type="text" data-f="instructions" list="instrList" placeholder="<%= editor.instructions[2] || '' %>">
      </div>
    </div>
    <div class="rx-preview-line" data-preview>Rp.: …</div>
  </div>
</template>

<datalist id="formList"><% editor.forms.forEach(function(v){ %><option value="<%= v %>"></option><% }) %></datalist>
<datalist id="routeList"><% editor.routes.forEach(function(v){ %><option value="<%= v %>"></option><% }) %></datalist>
<datalist id="freqList"><% editor.frequencies.forEach(function(v){ %><option value="<%= v %>"></option><% }) %></datalist>
<datalist id="durList"><% editor.durations.forEach(function(v){ %><option value="<%= v %>"></option><% }) %></datalist>
<datalist id="instrList"><% editor.instructions.forEach(function(v){ %><option value="<%= v %>"></option><% }) %></datalist>
