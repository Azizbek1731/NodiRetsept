<%
  // t — joriy qiymatlar (bo'lishi shart emas), ph — o'rnini bosuvchi (global blanka)
  const v = (k) => (t && t[k] != null ? t[k] : '');
  const p = (k) => (ph && ph[k] ? ph[k] : '');
  const on = (k) => (t && t[k] != null ? !!Number(t[k]) : (ph && ph[k] != null ? !!Number(ph[k]) : true));
%>
<fieldset>
  <legend><%= t('tpl.clinicInfo') %></legend>
  <div class="form-grid">
    <div class="field">
      <label><%= t('tpl.clinicName') %></label>
      <input type="text" name="clinic_name" value="<%= v('clinic_name') %>" placeholder="<%= p('clinic_name') || t('tpl.clinicName') %>">
    </div>
    <div class="field">
      <label><%= t('tpl.clinicSubtitle') %></label>
      <input type="text" name="clinic_subtitle" value="<%= v('clinic_subtitle') %>" placeholder="<%= p('clinic_subtitle') || '' %>">
    </div>
    <div class="field">
      <label><%= t('common.address') %></label>
      <input type="text" name="address" value="<%= v('address') %>" placeholder="<%= p('address') || '' %>">
    </div>
    <div class="field">
      <label><%= t('common.phone') %></label>
      <input type="text" name="phone" value="<%= v('phone') %>" placeholder="<%= p('phone') || '+998 71 200 00 00' %>">
    </div>
    <div class="field">
      <label><%= t('common.email') %></label>
      <input type="text" name="email" value="<%= v('email') %>" placeholder="<%= p('email') || 'info@example.uz' %>">
    </div>
    <div class="field">
      <label><%= t('common.website') %></label>
      <input type="text" name="website" value="<%= v('website') %>" placeholder="<%= p('website') || 'example.uz' %>">
    </div>
  </div>
</fieldset>

<fieldset>
  <legend><%= t('tpl.look') %></legend>
  <div class="form-grid">
    <div class="field">
      <label><%= t('tpl.accentColor') %></label>
      <div class="row gap-1">
        <input type="color" name="accent_color" value="<%= v('accent_color') || p('accent_color') || '#0e7c86' %>" style="max-width:70px">
        <span class="small muted"><%= t('tpl.accentHint') %></span>
      </div>
    </div>
  </div>
  <div class="field">
    <label><%= t('tpl.headerNote') %></label>
    <input type="text" name="header_note" value="<%= v('header_note') %>" placeholder="<%= t('common.optional') %>">
  </div>
  <div class="field">
    <label><%= t('tpl.footerNote') %></label>
    <input type="text" name="footer_note" value="<%= v('footer_note') %>"
           placeholder="<%= p('footer_note') || '' %>">
  </div>
</fieldset>

<fieldset>
  <legend><%= t('tpl.sections') %></legend>
  <div class="form-grid">
    <label class="check"><input type="checkbox" name="show_logo" <%= on('show_logo') ? 'checked' : '' %>> <%= t('tpl.showLogo') %></label>
    <label class="check"><input type="checkbox" name="show_qr" <%= on('show_qr') ? 'checked' : '' %>> <%= t('tpl.showQr') %></label>
    <label class="check"><input type="checkbox" name="show_complaints" <%= on('show_complaints') ? 'checked' : '' %>> <%= t('tpl.showComplaints') %></label>
    <label class="check"><input type="checkbox" name="show_icd" <%= on('show_icd') ? 'checked' : '' %>> <%= t('tpl.showIcd') %></label>
    <label class="check"><input type="checkbox" name="show_physio" <%= on('show_physio') ? 'checked' : '' %>> <%= t('tpl.showPhysio') %></label>
    <label class="check"><input type="checkbox" name="show_recommendations" <%= on('show_recommendations') ? 'checked' : '' %>> <%= t('tpl.showRecommendations') %></label>
    <label class="check"><input type="checkbox" name="show_signature" <%= on('show_signature') ? 'checked' : '' %>> <%= t('tpl.showSignature') %></label>
    <label class="check"><input type="checkbox" name="show_stamp" <%= on('show_stamp') ? 'checked' : '' %>> <%= t('tpl.showStamp') %></label>
  </div>
</fieldset>
