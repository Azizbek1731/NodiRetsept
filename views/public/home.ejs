<%- include('../partials/pub-head') %>

<section class="hero">
  <h1>Retseptingizni onlayn oling</h1>
  <p class="lead">Shifokor bergan <strong>ID raqamni</strong> kiriting yoki <strong>QR kodni</strong> skanerlang —
     retseptingiz darhol ochiladi va PDF ko'rinishida yuklab olinadi.</p>

  <div class="search-card">
    <% if (notFound) { %>
      <div class="flash error"><%- icon('alert',{size:18}) %>
        <span><strong><%= notFound %></strong> bo'yicha retsept topilmadi. ID ni tekshirib qayta urinib ko'ring.</span></div>
    <% } %>
    <form class="search-form" method="get" action="/search">
      <input type="text" name="id" data-rx-id-input placeholder="NR-XXXX-XXXX" aria-label="Retsept ID si"
             value="<%= notFound || '' %>" autocomplete="off" required>
      <button class="btn btn-primary btn-lg"><%- icon('search',{size:18}) %> Topish</button>
    </form>
    <div class="or-line">yoki</div>
    <div class="row gap-2" style="justify-content:center;flex-wrap:wrap">
      <a class="btn btn-lg" href="/scan"><%- icon('qr',{size:18}) %> QR kodni skanerlash</a>
      <a class="btn btn-lg" href="https://t.me/<%= botUsername || 'NodiRetsept_bot' %>" target="_blank" rel="noopener">
        <%- icon('send',{size:18}) %> Telegram bot</a>
    </div>
  </div>
</section>

<section class="steps">
  <div class="step">
    <div class="n">1</div><h3>Shifokor retsept yozadi</h3>
    <p>Qabuldan so'ng shifokor tizimda retsept rasmiylashtiradi va sizga ID hamda QR kod beradi.</p>
  </div>
  <div class="step">
    <div class="n">2</div><h3>QR yoki ID kiritasiz</h3>
    <p>Telefon kamerasi bilan QR kodni skanerlang yoki yuqoridagi maydonga ID ni kiriting.</p>
  </div>
  <div class="step">
    <div class="n">3</div><h3>PDF ni yuklab olasiz</h3>
    <p>Retsept ekranda ochiladi — uni PDF sifatida saqlash yoki chop etish mumkin.</p>
  </div>
  <div class="step">
    <div class="n">4</div><h3>Telegram orqali ham</h3>
    <p>Botga ID ni yuboring — retsept PDF fayli darhol jo'natiladi.</p>
  </div>
</section>

<%- include('../partials/pub-foot') %>
