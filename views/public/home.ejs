<%- include('../partials/pub-head') %>

<section class="hero">
  <h1><%= t('home.heroTitle') %></h1>
  <p class="lead"><%- t('home.heroLead') %></p>

  <div class="search-card">
    <% if (notFound) { %>
      <div class="flash error"><%- icon('alert',{size:18}) %>
        <span><%- t('home.notFound', { id: notFound }) %></span></div>
    <% } %>
    <form class="search-form" method="get" action="/search">
      <input type="text" name="id" data-rx-id-input placeholder="NR-XXXX-XXXX" aria-label="<%= t('home.idLabel') %>"
             value="<%= notFound || '' %>" autocomplete="off" required>
      <button class="btn btn-primary btn-lg"><%- icon('search',{size:18}) %> <%= t('home.find') %></button>
    </form>
    <div class="or-line"><%= t('home.or') %></div>
    <div class="row gap-2" style="justify-content:center;flex-wrap:wrap">
      <a class="btn btn-lg" href="/scan"><%- icon('qr',{size:18}) %> <%= t('home.scanQr') %></a>
      <a class="btn btn-lg" href="https://t.me/<%= botUsername || 'NodiRetsept_bot' %>" target="_blank" rel="noopener">
        <%- icon('send',{size:18}) %> <%= t('home.telegramBot') %></a>
    </div>
  </div>
</section>

<section class="steps">
  <div class="step">
    <div class="n">1</div><h3><%= t('home.step1t') %></h3>
    <p><%= t('home.step1d') %></p>
  </div>
  <div class="step">
    <div class="n">2</div><h3><%= t('home.step2t') %></h3>
    <p><%= t('home.step2d') %></p>
  </div>
  <div class="step">
    <div class="n">3</div><h3><%= t('home.step3t') %></h3>
    <p><%= t('home.step3d') %></p>
  </div>
  <div class="step">
    <div class="n">4</div><h3><%= t('home.step4t') %></h3>
    <p><%= t('home.step4d') %></p>
  </div>
</section>

<%- include('../partials/pub-foot') %>
