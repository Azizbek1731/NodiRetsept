<%- include('../partials/pub-head') %>

<% if (rx.status === 'cancelled') { %>
  <div class="verify-banner cancelled no-print">
    <%- icon('alert',{size:19}) %>
    <span><%- t('rx.cancelled') %></span>
  </div>
<% } else { %>
  <div class="verify-banner no-print">
    <%- icon('shield',{size:19}) %>
    <span><%- t('rx.genuine', { date: fmt.dateTime(rx.created_at), doctor: rx.doctor.full_name }) %></span>
  </div>
<% } %>

<%- include('../partials/rx-sheet', { rx }) %>

<div class="rx-actions no-print">
  <a class="btn btn-primary btn-lg" href="/r/<%= rx.public_id %>/pdf"><%- icon('download',{size:18}) %> <%= t('rx.downloadPdf') %></a>
  <button class="btn btn-lg" onclick="window.print()"><%- icon('print',{size:18}) %> <%= t('common.print') %></button>
  <button class="btn btn-lg" data-copy="<%= rx.url %>"><%- icon('link',{size:18}) %> <%= t('rx.copyLink') %></button>
  <% if (isStaff) { %>
    <a class="btn btn-lg" href="<%= currentUser.role === 'admin' ? '/admin/prescriptions' : '/prescriptions' %>">
      <%- icon('chevronLeft',{size:18}) %> <%= t('rx.backList') %></a>
  <% } %>
</div>

<div class="center small muted no-print mt-2">
  <%= t('rx.views') %>: <%= rx.view_count %> · <%= t('rx.rxId') %>: <span class="mono strong"><%= rx.pretty_id %></span>
</div>

<script>
  if (new URLSearchParams(location.search).get('print') === '1') {
    window.addEventListener('load', () => setTimeout(() => window.print(), 400));
  }
</script>
<%- include('../partials/pub-foot') %>
