<%- include('../partials/pub-head') %>
<div class="scanner-wrap">
  <div class="center mb-3">
    <h1>QR kodni skanerlang</h1>
    <p class="muted">Kamerani retsept blankasidagi QR kodga qarating</p>
  </div>

  <div class="scanner-view" id="scanView">
    <div class="scanner-placeholder" id="scanPlaceholder">
      <%- icon('camera',{size:52}) %>
      <div>Kamerani yoqish uchun tugmani bosing</div>
    </div>
    <video id="scanVideo" playsinline muted class="hide"></video>
    <div class="scanner-frame hide" id="scanFrame"></div>
    <div class="scanner-hint hide" id="scanHint">QR kodni ramka ichiga joylashtiring…</div>
  </div>

  <div class="rx-actions">
    <button class="btn btn-primary btn-lg" id="scanStart"><%- icon('camera',{size:18}) %> Kamerani yoqish</button>
    <button class="btn btn-lg hide" id="scanStop"><%- icon('x',{size:18}) %> To'xtatish</button>
  </div>

  <div class="card mt-3">
    <h4>Kamera ishlamayaptimi?</h4>
    <p class="small muted mb-2">Retsept ID sini qo'lda kiriting — u QR kod ostida yozilgan.</p>
    <form class="search-form" method="get" action="/search">
      <input type="text" name="id" data-rx-id-input placeholder="NR-XXXX-XXXX" required>
      <button class="btn btn-primary"><%- icon('search',{size:16}) %> Topish</button>
    </form>
    <p class="hint mt-2">Eslatma: kamera faqat <strong>HTTPS</strong> yoki <strong>localhost</strong> orqali ochilganda ishlaydi.</p>
  </div>
</div>
<script src="/vendor/jsqr.js"></script>
<%- include('../partials/pub-foot', { pageScript: 'scanner.js' }) %>
