<%- include('../partials/pub-head') %>
<div class="scanner-wrap">
  <div class="center mb-3">
    <h1><%= t('scan.title') %></h1>
    <p class="muted"><%= t('scan.subtitle') %></p>
  </div>

  <div class="scanner-view" id="scanView">
    <div class="scanner-placeholder" id="scanPlaceholder">
      <%- icon('camera',{size:52}) %>
      <div><%= t('scan.placeholder') %></div>
    </div>
    <video id="scanVideo" playsinline muted class="hide"></video>
    <div class="scanner-frame hide" id="scanFrame"></div>
    <div class="scanner-hint hide" id="scanHint"><%= t('scan.hint') %></div>
  </div>

  <div class="rx-actions">
    <button class="btn btn-primary btn-lg" id="scanStart"><%- icon('camera',{size:18}) %> <%= t('scan.enable') %></button>
    <button class="btn btn-lg hide" id="scanStop"><%- icon('x',{size:18}) %> <%= t('scan.stop') %></button>
  </div>

  <div class="card mt-3">
    <h4><%= t('scan.noCameraTitle') %></h4>
    <p class="small muted mb-2"><%= t('scan.noCameraText') %></p>
    <form class="search-form" method="get" action="/search">
      <input type="text" name="id" data-rx-id-input placeholder="NR-XXXX-XXXX" required>
      <button class="btn btn-primary"><%- icon('search',{size:16}) %> <%= t('home.find') %></button>
    </form>
    <p class="hint mt-2"><%- t('scan.httpsNote') %></p>
  </div>
</div>
<script src="/vendor/jsqr.js"></script>
<%- include('../partials/pub-foot', { pageScript: 'scanner.js' }) %>
